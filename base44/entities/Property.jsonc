{
  "name": "Property",
  "type": "object",
  "title": "Property",
  "properties": {
    "property_code": {
      "type": "string",
      "title": "Cod proprietate unic (6 cifre + 6 litere)"
    },
    "title": {
      "type": "string",
      "title": "Titlu"
    },
    "description": {
      "type": "string",
      "title": "Descriere"
    },
    "price_monthly": {
      "type": "number",
      "title": "Preț"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "RENT",
        "SALE"
      ],
      "default": "RENT",
      "title": "Tip tranzacție"
    },
    "currency": {
      "type": "string",
      "enum": [
        "EUR",
        "RON",
        "GBP"
      ],
      "default": "EUR",
      "title": "Monedă"
    },
    "country": {
      "type": "string",
      "enum": [
        "RO"
      ],
      "default": "RO",
      "title": "Țară"
    },
    "county": {
      "type": "string",
      "title": "Județ"
    },
    "city": {
      "type": "string",
      "title": "Oraș"
    },
    "zone": {
      "type": "string",
      "title": "Zona / Cartier"
    },
    "landmark": {
      "type": "string",
      "title": "Punct de reper / Stradă"
    },
    "property_type": {
      "type": "string",
      "enum": [
        "Garsonieră",
        "2 Camere",
        "3 Camere",
        "4+ Camere",
        "Casă",
        "Studio",
        "Teren",
        "Spațiu Comercial"
      ],
      "title": "Tip proprietate"
    },
    "rooms": {
      "type": "number",
      "title": "Nr. camere"
    },
    "surface_sqm": {
      "type": "number",
      "title": "Suprafață (mp)"
    },
    "floor": {
      "type": "string",
      "title": "Etaj"
    },
    "total_floors": {
      "type": "number",
      "title": "Total etaje clădire"
    },
    "building_year": {
      "type": "number",
      "title": "An construcție"
    },
    "deposit": {
      "type": "number",
      "title": "Depozit"
    },
    "furnished": {
      "type": "boolean",
      "default": true,
      "title": "Mobilat"
    },
    "pet_friendly": {
      "type": "boolean",
      "default": false,
      "title": "Pet Friendly"
    },
    "parking": {
      "type": "boolean",
      "default": false,
      "title": "Parcare"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Facilități"
    },
    "phone": {
      "type": "string",
      "title": "Telefon contact"
    },
    "whatsapp_phone": {
      "type": "string",
      "title": "WhatsApp (digital internațional)"
    },
    "seller_role": {
      "type": "string",
      "enum": [
        "Proprietar",
        "Agent"
      ],
      "default": "Proprietar",
      "title": "Rol vânzător"
    },
    "available_from": {
      "type": "string",
      "format": "date",
      "title": "Disponibil din"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Imagini"
    },
    "ai_video_url": {
      "type": "string",
      "title": "Tur AI / Video URL"
    },
    "tour_3d_url": {
      "type": "string",
      "title": "Link Tur 3D (Matterport — setat de admin)"
    },
    "latitude": {
      "type": "number",
      "title": "Latitudine"
    },
    "longitude": {
      "type": "number",
      "title": "Longitudine"
    },
    "owner_name": {
      "type": "string",
      "title": "Nume proprietar"
    },
    "posted_by_name": {
      "type": "string",
      "title": "Autor postare (cine a publicat)"
    },
    "owner_verified": {
      "type": "boolean",
      "default": false,
      "title": "Proprietar verificat"
    },
    "ai_tour_verified": {
      "type": "boolean",
      "default": false,
      "title": "Tur AI verificat"
    },
    "status": {
      "type": "string",
      "enum": [
        "Activ",
        "Rezervat",
        "Închis"
      ],
      "default": "Activ",
      "title": "Status"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED"
      ],
      "default": "PENDING",
      "title": "Aprobare anunț"
    },
    "approved_by_id": {
      "type": "string",
      "title": "Aprobat de (ID admin)"
    },
    "approved_by_name": {
      "type": "string",
      "title": "Aprobat de (nume admin)"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time",
      "title": "Data aprobării"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "Featured"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "title": "Vizualizări"
    },
    "verification_level": {
      "type": "string",
      "enum": [
        "unverified",
        "video_ai",
        "field_certified"
      ],
      "default": "unverified",
      "title": "Nivel verificare"
    },
    "inspection_report_url": {
      "type": "string",
      "title": "Raport inspecție (PDF)"
    },
    "noise_db": {
      "type": "number",
      "title": "Zgomot ambiental (dB)"
    },
    "light_orientation": {
      "type": "string",
      "title": "Orientare lumină"
    },
    "water_pressure_ok": {
      "type": "boolean",
      "default": true,
      "title": "Presiune apă OK"
    },
    "internet_speed_mbps": {
      "type": "number",
      "title": "Viteză internet (Mbps)"
    },
    "metro_distance_min": {
      "type": "number",
      "title": "Drum metrou (min)"
    },
    "deposit_option": {
      "type": "string",
      "enum": [
        "standard",
        "verificasa_guarantee"
      ],
      "default": "standard",
      "title": "Opțiune garanție"
    },
    "monthly_utilities_estimate": {
      "type": "number",
      "title": "Estimare utilități/lună"
    },
    "maintenance_fee": {
      "type": "number",
      "title": "Întreținere/lună"
    },
    "price_fairness": {
      "type": "string",
      "enum": [
        "sub_piata",
        "corect",
        "peste_medie"
      ],
      "title": "Corectitudine preț"
    },
    "commission_free": {
      "type": "boolean",
      "default": false,
      "title": "Fără comision"
    },
    "reserve_instant": {
      "type": "boolean",
      "default": false,
      "title": "Rezervare instantă"
    },
    "is_swap_available": {
      "type": "boolean",
      "default": false,
      "title": "Disponibil schimb de chirie"
    },
    "has_walkthrough_tour": {
      "type": "boolean",
      "default": false,
      "title": "Are tur 360 (walkthrough)"
    },
    "trust_score": {
      "type": "number",
      "default": 0,
      "title": "Scor de incredere (calculat automat)"
    },
    "external_inspection_pending": {
      "type": "boolean",
      "default": false,
      "title": "Inspecție externă în curs"
    },
    "poster_plan": {
      "type": "string",
      "enum": [
        "basic",
        "pro",
        "agent"
      ],
      "title": "Planul postatorului (denormalizat, scris doar server-side)"
    },
    "boost_active": {
      "type": "boolean",
      "default": false,
      "title": "Boost activ"
    },
    "boost_ends_date": {
      "type": "string",
      "format": "date-time",
      "title": "Boost expira la (nefolosit - boost-urile nu expira)"
    },
    "boost_count": {
      "type": "number",
      "default": 0,
      "title": "Cate boost-uri are anuntul (se aduna, nu expira)"
    },
    "trust_breakdown": {
      "type": "string",
      "title": "Detaliere scor (JSON, scris server-side)",
      "maxLength": 4000
    }
  },
  "required": [
    "title",
    "price_monthly",
    "country",
    "city",
    "property_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}
