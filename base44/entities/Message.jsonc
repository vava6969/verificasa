{
  "name": "Message",
  "type": "object",
  "title": "Message",
  "properties": {
    "conversation_id": {
      "type": "string",
      "title": "Conversation ID"
    },
    "sender_id": {
      "type": "string",
      "title": "Sender ID"
    },
    "sender_name": {
      "type": "string",
      "title": "Nume expeditor"
    },
    "recipient_id": {
      "type": "string",
      "title": "Destinatar (ID) — pentru RLS pe citire"
    },
    "content": {
      "type": "string",
      "title": "Mesaj"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "title": "Citit la (timestamp)"
    },
    "property_ref_id": {
      "type": "string",
      "title": "Card proprietate ata\u0219at \u2014 ID"
    },
    "property_ref_title": {
      "type": "string",
      "title": "Card proprietate ata\u0219at \u2014 titlu"
    },
    "property_ref_image": {
      "type": "string",
      "title": "Card proprietate ata\u0219at \u2014 thumbnail"
    },
    "property_ref_price": {
      "type": "number",
      "title": "Card proprietate ata\u0219at \u2014 pre\u021b"
    },
    "property_ref_currency": {
      "type": "string",
      "title": "Card proprietate ata\u0219at \u2014 moned\u0103"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "title": "Mesaj sistem (notificare automat\u0103)"
    },
    "system_type": {
      "type": "string",
      "title": "Tip mesaj sistem (ex: review_request)"
    }
  },
  "required": [
    "conversation_id",
    "sender_id",
    "content"
  ],
  // RLS in doi pasi, deliberat.
  //
  // PASUL 1 (acesta): `create` e inchis. Era `null`, adica oricine, inclusiv un
  // apelant anonim pe REST, putea scrie mesaje in orice conversatie.
  // `created_by_id` acopera si mesajul de sistem, care pleaca cu
  // sender_id: "system" dar e creat de utilizatorul logat.
  //
  // PASUL 2 (dupa publish + backfill): `read` si `update` raman deocamdata
  // deschise INTENTIONAT. Message nu are decat `sender_id` — nu exista camp
  // care sa spuna cine e destinatarul, deci orice regula de citire scrisa azi
  // ar ascunde mesajele chiar de la omul caruia ii sunt adresate, si ar rupe
  // read_at (destinatarul stampileaza, nu expeditorul).
  // `recipient_id` de mai sus e campul care lipsea. Ordinea obligatorie:
  //   1. publish (campurile noi sunt inghitite tacut la `create` pana atunci),
  //   2. backfill pe mesajele existente, care nu au recipient_id,
  //   3. abia apoi read/update devin
  //      {"$or":[{"data.sender_id":"{{user.id}}"},{"data.recipient_id":"{{user.id}}"}, ...admin]}.
  // Inversarea ordinii scoate utilizatorii din propriul istoric.
  "rls": {
    "create": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}