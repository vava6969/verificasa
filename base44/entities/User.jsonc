{
  "name": "User",
  "type": "object",
  "title": "User",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "SUPER_ADMIN",
        "ADMIN",
        "AGENT",
        "PROPRIETAR",
        "SUPPORT",
        "admin",
        "user"
      ],
      "default": "user",
      "title": "Rol"
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "title": "Verificat"
    },
    "phone": {
      "type": "string",
      "title": "Telefon"
    },
    "whatsapp_phone": {
      "type": "string",
      "title": "WhatsApp"
    },
    "avatar_url": {
      "type": "string",
      "title": "Avatar URL"
    }
  }
}