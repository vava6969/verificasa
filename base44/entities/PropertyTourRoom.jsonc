{
  "name": "PropertyTourRoom",
  "type": "object",
  "title": "Camer\u0103 tur virtual 360\u00b0",
  "properties": {
    "property_id": {
      "type": "string",
      "title": "ID proprietate"
    },
    "room_name": {
      "type": "string",
      "title": "Nume camer\u0103"
    },
    "order_index": {
      "type": "number",
      "default": 0,
      "title": "Ordine \u00een tur"
    },
    "frame_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Poze rota\u021bie (secven\u021b\u0103 360\u00b0)"
    }
  },
  "required": [
    "property_id",
    "room_name",
    "frame_urls"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "ADMIN"
          }
        },
        {
          "user_condition": {
            "role": "SUPER_ADMIN"
          }
        }
      ]
    }
  }
}